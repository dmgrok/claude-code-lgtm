{
  "name": "cc-tricks",
  "version": "1.0.1",
  "description": "CC-Tricks — Claude Code Cookbook: presets, guardrails, and tricks for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cc-tricks": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "presets/"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && npm run build:action && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "build:action": "esbuild src/action.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/action.cjs --log-level=warning",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.lint.json",
    "check": "tsx src/cli.ts check",
    "scan": "tsx src/cli.ts scan"
  },
  "keywords": [
    "agent-skills",
    "cc-tricks",
    "validation",
    "security-scanner",
    "ai-agents",
    "skill-validation",
    "github-action",
    "cli"
  ],
  "author": "David Graça",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.1",
    "esbuild": "0.27.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@actions/http-client": {
      "undici": "^6.28.1"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmgrok/claude-code-lgtm.git"
  },
  "homepage": "https://github.com/dmgrok/claude-code-lgtm#readme",
  "bugs": {
    "url": "https://github.com/dmgrok/claude-code-lgtm/issues"
  }
}
